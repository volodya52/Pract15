<Page x:Class="Pract15.Pages.AddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract15.Pages"
      mc:Ignorable="d" 
      xmlns:conventer="clr-namespace:Pract15.Conventor"
      xmlns:service="clr-namespace:Pract15.Service"
      xmlns:validators="clr-namespace:Pract15.Validators"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditPage">

    <Page.Resources>
        <service:TagService x:Key="tService"/>
        <service:BrandService x:Key="bService"/>
        <service:CategoryService x:Key="cService"/>
        <conventer:DateOnlyConventer x:Key="DateConventer"/>
    </Page.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" Style="{StaticResource MaterialDesignScrollViewer}">
            <StackPanel>
                <StackPanel>
                    <Label Style="{DynamicResource filtrLabel}">Название</Label>
                    <TextBox Style="{DynamicResource InputTextBox}">
                        <TextBox.Text>
                            <Binding Path="Name" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:EmptyText/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel>
                    <Label Style="{DynamicResource filtrLabel}">Описание</Label>
                    <TextBox Style="{DynamicResource InputTextBox}">
                        <TextBox.Text>
                            <Binding Path="Description" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:EmptyText/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel>
                    <Label Style="{DynamicResource filtrLabel}">Цена</Label>
                    <TextBox Style="{DynamicResource InputTextBox}">
                        <TextBox.Text>
                            <Binding Path="Price" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:EmptyText/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel>
                    <Label Style="{DynamicResource filtrLabel}">Количество</Label>
                    <TextBox Style="{DynamicResource InputTextBox}">
                        <TextBox.Text>
                            <Binding Path="Stock" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:EmptyText/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel>
                    <Label Style="{DynamicResource filtrLabel}">Рейтинг</Label>
                    <TextBox Style="{DynamicResource InputTextBox}">
                        <TextBox.Text>
                            <Binding Path="Stock" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:EmptyText/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel>
                    <Label Style="{DynamicResource filtrLabel}">Дата</Label>
                    <DatePicker Style="{DynamicResource InputDate}">
                        <DatePicker.SelectedDate>
                            <Binding Converter="{StaticResource DateConventer}" Path="CreatedAt" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:EmptyText/>
                                    <validators:CheckDate/>
                                </Binding.ValidationRules>
                            </Binding>
                        </DatePicker.SelectedDate>
                    </DatePicker>
                </StackPanel>
                <StackPanel>
                    <Label Style="{DynamicResource filtrLabel}">Бренд</Label>
                    <ComboBox SelectedItem="{Binding Brand.Name}" 
                              ItemsSource="{Binding Source={StaticResource bService}, Path=Brands}"
                              Style="{DynamicResource InputComboBox}" 
                              DisplayMemberPath="Name"/>


                </StackPanel>
                <StackPanel>
                    <Label Style="{DynamicResource filtrLabel}">Категория</Label>
                    <ComboBox SelectedItem="{Binding Category.Name}" 
                              ItemsSource="{Binding Source={StaticResource cService}, Path=Categories}"
                              Style="{DynamicResource InputComboBox}"
                              DisplayMemberPath="Name"/>


                </StackPanel>
                <StackPanel>
                    <Label Style="{DynamicResource filtrLabel}">Тэг</Label>
                    <ComboBox Style="{DynamicResource InputComboBox}" 
                              ItemsSource="{Binding Source={StaticResource tService}, Path=Tags}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding Tag}">
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <Button Click="Back" Style="{DynamicResource ButtonSignIn}">Сохранить</Button>
                    <Button Click="SaveProduct" Style="{DynamicResource ButtonSignIn}">Назад</Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
