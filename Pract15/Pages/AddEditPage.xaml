<Page x:Class="Pract15.Pages.AddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract15.Pages"
      mc:Ignorable="d" 
      xmlns:conventer="clr-namespace:Pract15.Conventor"
      xmlns:service="clr-namespace:Pract15.Service"
      xmlns:validators="clr-namespace:Pract15.Validators"
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="Page_Loaded"
      Title="AddEditPage">

    <Page.Resources>
        <service:TagService x:Key="tService"/>
        <service:BrandService x:Key="bService"/>
        <service:CategoryService x:Key="cService"/>
        <conventer:DateOnlyConventer x:Key="DateConventer"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
       
            <StackPanel Grid.Column="0">
                <StackPanel>
                    <Label Style="{DynamicResource filtrLabel}">Название</Label>
                    <TextBox Style="{DynamicResource InputTextBox}">
                        <TextBox.Text>
                            <Binding Path="MainProduct.Name" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:EmptyText/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel>
                    <Label Style="{DynamicResource filtrLabel}">Описание</Label>
                    <TextBox Style="{DynamicResource InputTextBox}">
                        <TextBox.Text>
                            <Binding Path="MainProduct.Description" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:EmptyText/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel>
                    <Label Style="{DynamicResource filtrLabel}">Цена</Label>
                    <TextBox Style="{DynamicResource InputTextBox}">
                        <TextBox.Text>
                            <Binding Path="MainProduct.Price" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:EmptyText/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel>
                    <Label Style="{DynamicResource filtrLabel}">Количество</Label>
                    <TextBox Style="{DynamicResource InputTextBox}">
                        <TextBox.Text>
                            <Binding Path="MainProduct.Stock" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:EmptyText/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
                <StackPanel>
                    <Label Style="{DynamicResource filtrLabel}">Рейтинг</Label>
                    <TextBox Style="{DynamicResource InputTextBox}">
                        <TextBox.Text>
                            <Binding Path="MainProduct.Rating" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <validators:EmptyText/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </StackPanel>
        <StackPanel Grid.Column="1">
            <StackPanel>
                <Label Style="{DynamicResource filtrLabel}">Дата</Label>
                <DatePicker Style="{DynamicResource InputDate}">
                    <DatePicker.SelectedDate>
                        <Binding Converter="{StaticResource DateConventer}" Path="MainProduct.CreatedAt" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <validators:EmptyText/>
                                <validators:CheckDate/>
                            </Binding.ValidationRules>
                        </Binding>
                    </DatePicker.SelectedDate>
                </DatePicker>
            </StackPanel>
            <StackPanel>
                <Label Style="{DynamicResource filtrLabel}">Бренд</Label>
                <ComboBox SelectedValuePath="Id" 
                  ItemsSource="{Binding Brands}"
                  Style="{DynamicResource InputComboBox}" 
                  DisplayMemberPath="Name"/>


            </StackPanel>
            <StackPanel>
                <Label Style="{DynamicResource filtrLabel}">Категория</Label>
                <ComboBox SelectedValuePath="Id" 
                  ItemsSource="{Binding Categories}"
                  Style="{DynamicResource InputComboBox}" 
                  DisplayMemberPath="Name"/>


            </StackPanel>
            <StackPanel>
                <Label Style="{DynamicResource filtrLabel}">Тэг</Label>
                <ListBox ItemsSource="{Binding Tags}" Margin="0,0,0,10" SelectionMode="Multiple" Height="50">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" 
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                              Margin="2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <StackPanel>
                <Button Click="SaveProduct" Style="{DynamicResource ButtonSignIn}">Сохранить</Button>
                <Button Click="Back" Style="{DynamicResource ButtonSignIn}">Назад</Button>
            </StackPanel>
        </StackPanel>
           
        
    </Grid>
</Page>
