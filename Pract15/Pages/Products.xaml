<Page x:Class="Pract15.Pages.Products"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract15.Pages"
      mc:Ignorable="d" 
     xmlns:service="clr-namespace:Pract15.Service"
      xmlns:validators="clr-namespace:Pract15.Validators"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:conventer="clr-namespace:Pract15.Conventor"
      d:DesignHeight="650" d:DesignWidth="800"
      Loaded="Page_Loaded"
      
      Title="Products">

    <Page.Resources>
        <service:BrandService x:Key="bService"/>
        <service:TagService x:Key="tService"/>
        <service:CategoryService x:Key="cService"/>
    </Page.Resources>

    <Grid>
        <Grid.Resources>
            <conventer:Conventor x:Key="Conventor1"/>
            <conventer:BorderConventer x:Key="cBorder"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>

            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
            <Label Style="{DynamicResource searchLabel}">Поиск</Label>
            <TextBox Style="{DynamicResource SearchTextBox}" 
                     materialDesign:HintAssist.Hint="Введите текст для поиска" TextChanged="TextBox_TextChanged">
                <TextBox.Text>
                    <Binding Path="searchQuery" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:EmptyText/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.RowSpan="4" Grid.Column="0">
            <Label Style="{DynamicResource filtrLabel}">Сортировка</Label>
            <ComboBox Style="{DynamicResource sortComboBox}" SelectionChanged="ComboBox_SelectionChanged">
                <ComboBox.Items>
                    <ComboBoxItem Style="{DynamicResource ItemsComboBox}" Tag="Наименование">По названию</ComboBoxItem>
                    <ComboBoxItem Style="{DynamicResource ItemsComboBox}" Tag="ЦенаМинус">По цене (по убыванию)</ComboBoxItem>
                    <ComboBoxItem Style="{DynamicResource ItemsComboBox}" Tag="ЦенаПлюс">По цене (по возрастанию)</ComboBoxItem>
                    <ComboBoxItem Style="{DynamicResource ItemsComboBox}" Tag="КоличествоМинус">По количеству (по убыванию)</ComboBoxItem>
                    <ComboBoxItem Style="{DynamicResource ItemsComboBox}" Tag="КоличествоПлюс">По количеству (по возрастанию)</ComboBoxItem>
                </ComboBox.Items>
            </ComboBox>
            
            <Label Style="{DynamicResource filtrLabel}">Фильтр по брендам</Label>
            <StackPanel>
                <ComboBox ItemsSource="{Binding Source={StaticResource bService}, Path=Brands}" 
                          Style="{DynamicResource InputComboBox}"
                          SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                          DisplayMemberPath="Name" 
                        />


            </StackPanel>
            <Label Style="{DynamicResource filtrLabel}">Фильтр по категориям</Label>
            <ComboBox ItemsSource="{Binding Source={StaticResource cService}, Path=Categories}"
                      Style="{DynamicResource InputComboBox}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                      DisplayMemberPath="Name"                     
                   />
            <Label Style="{DynamicResource filtrLabel}">Фильтр по цене</Label>
            <StackPanel>
                <Label FontSize="15">От</Label>
                <TextBox Style="{DynamicResource InputTextBox}" Text="{Binding filterFrom, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged"/>
                <Label FontSize="15">До</Label>
                <TextBox Style="{DynamicResource InputTextBox}" Text="{Binding filterTo, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged"/>
                
            </StackPanel>
        </StackPanel>




        <ListView Grid.Row="0"
                  Grid.RowSpan="3"
                  Grid.Column="1" 
                  Grid.ColumnSpan="2"
                  ItemsSource="{Binding products}" 
                  SelectedItem="{Binding product}"
                  MouseDoubleClick="ProductsList_MouseDoubleClick"          
                  Style="{DynamicResource ListViewItem}"
                  Name="ProductsList">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Width="Auto" Height="Auto" BorderThickness="2" BorderBrush="{Binding Stock, Converter={StaticResource cBorder}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="★">
                                    <Run Text="{Binding Rating}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Категория"/>
                                    <Run Text="{Binding Category.Name}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Описание"/>
                                    <Run Text="{Binding Description}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Tags, Converter={StaticResource Conventor1}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock HorizontalAlignment="Right">
                                    <Run Text="Стоимость"/>
                                    <Run Text="{Binding Price}"/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right">
                                    <Run Text="Количество"/>
                                    <Run Text="{Binding Stock}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel   Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2">
            <Button Visibility="Hidden" Click="DeleteButton_Click"  x:Name="DeleteButton" Style="{DynamicResource DeleteButton}">Удалить</Button>
            <Button Visibility="Hidden" Click="GoTags" x:Name="TagsButton" Style="{DynamicResource TagsButton}">Тэги</Button>
            <Button Visibility="Hidden" Click="GoBrands" x:Name="BrandsButton" Style="{DynamicResource BrandsButton}">Бренды</Button>
            <Button Visibility="Hidden" Click="GoCategories" x:Name="CategoryButton" Style="{DynamicResource CategoryButton}">Категории</Button>
            <Button Visibility="Hidden" Click="AddEditProduct" x:Name="AddButton" Style="{DynamicResource AddButton}" Content="Добавить"/>

        </StackPanel>
    </Grid>
</Page>
    